.title-board {
  width: 420rpx; height: 88rpx; line-height: 88rpx; margin: 6rpx auto 26rpx;
  background: linear-gradient(180deg, #8b5a33, #6e4524);
  border-radius: 22rpx; text-align:center; color:#fff2d7; font-size: 34rpx; font-weight: 900;
  box-shadow: inset 0 4rpx 0 rgba(255,255,255,.14), 0 10rpx 20rpx rgba(0,0,0,.22);
}
.hero-card {
  position: relative; overflow: hidden; min-height: 220rpx;
  border-radius: 36rpx; margin-bottom: 24rpx; box-shadow: 0 18rpx 28rpx rgba(0,0,0,.25);
}
.hero-card.purple { background: linear-gradient(135deg, #7242a0, #3b2354); }
.hero-card.orange { background: linear-gradient(135deg, #f7af3d, #d67222); }
.hero-card.light { background: linear-gradient(180deg, #fff4e3, #fbe8cb); padding: 30rpx; display:flex; align-items:center; }
.hero-bg { position:absolute; inset:0; width:100%; height:100%; opacity:.26; }
.hero-mask { position:absolute; inset:0; background: linear-gradient(90deg, rgba(32,18,51,.26), rgba(32,18,51,.55)); }
.hero-mask.warm { background: linear-gradient(90deg, rgba(155,71,13,.18), rgba(155,71,13,.42)); }
.hero-content { position: relative; z-index: 2; padding: 30rpx; width: calc(100% - 100rpx); }
.hero-title { color:#fff7e2; font-size: 48rpx; font-weight: 900; }
.hero-desc { color:#fff1d0; font-size: 26rpx; margin: 12rpx 0 8rpx; }
.hero-arrow { position:absolute; right: 28rpx; top: 50%; transform: translateY(-50%); color:#fff; font-size: 64rpx; z-index: 2; }
.chip.dark { background: rgba(255,255,255,.18); color:#fff3d9; border-color: rgba(255,255,255,.10); }
.chip.light { background: rgba(255,255,255,.24); color:#fff6e2; border-color: rgba(255,255,255,.18); }
.gift { width: 110rpx; height:110rpx; border-radius: 28rpx; background:#8b5fd1; color:#fff; font-size: 58rpx; display:flex; align-items:center; justify-content:center; margin-right: 20rpx; }
.brown { color:#6c3d19; } .brown2 { color:#8f6848; }
