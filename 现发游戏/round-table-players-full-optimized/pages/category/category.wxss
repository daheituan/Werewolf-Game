.room-strip { padding:18rpx; border-radius:30rpx; background:rgba(255,255,255,.14); color:#fff; }
.game-icon{width:96rpx;height:96rpx;border-radius:22rpx;background:#963326;display:flex;align-items:center;justify-content:center;font-size:54rpx;margin-right:18rpx;border:4rpx solid #ffd69e}.room-title{font-size:30rpx;font-weight:900}.avatars{display:flex;max-width:300rpx;overflow:hidden}.avatars .avatar{margin-left:-10rpx}
.cat-list{margin-top:32rpx}.cat-card{min-height:210rpx;border-radius:34rpx;margin-bottom:24rpx;padding:28rpx;display:flex;align-items:center;box-shadow:0 16rpx 28rpx rgba(0,0,0,.22);position:relative;overflow:hidden}.cat-card.werewolf{background:linear-gradient(135deg,#6f3b89,#3a2452);color:#fff}.cat-card.guess{background:linear-gradient(135deg,#ffb13b,#dd7c22);color:#fff}.cat-card.more{background:#fff0d8;color:#6b3a20}.cat-icon{width:150rpx;height:150rpx;border-radius:32rpx;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;font-size:88rpx;margin-right:24rpx}.cat-title{font-size:44rpx;font-weight:900}.cat-desc{font-size:26rpx;margin:12rpx 0}.mini{background:rgba(255,255,255,.22);color:inherit;border:0}.arrow{position:absolute;right:28rpx;font-size:58rpx}.create-entry{margin:10rpx auto 28rpx;width:560rpx;border-radius:30rpx;background:rgba(255,255,255,.18);color:#fff;padding:20rpx 28rpx;font-size:30rpx;font-weight:800}.create-entry text{display:block;font-size:22rpx;font-weight:400;opacity:.85;margin-top:6rpx}
