.home-page { overflow: hidden; }
.row { display:flex; align-items:center; }
.room-bar {
  position: relative;
  z-index: 2;
  padding: 20rpx 24rpx;
  display:flex; align-items:center; justify-content:space-between;
  color:#fff;
}
.wolf-icon {
  width: 92rpx; height: 92rpx; border-radius: 24rpx;
  background: linear-gradient(180deg, #9d2f25, #6d2118);
  border: 4rpx solid #ffcf91;
  display:flex; align-items:center; justify-content:center;
  font-size: 52rpx; margin-right: 18rpx;
  box-shadow: 0 10rpx 16rpx rgba(0,0,0,.18);
}
.room-name { font-size: 30rpx; font-weight: 900; color:#fff5df; }
.lock { font-size: 24rpx; }
.room-no { margin-top: 6rpx; font-size: 24rpx; color: rgba(255,255,255,.82); }
.joined {
  min-width: 188rpx; height: 80rpx; border-radius: 40rpx;
  background: rgba(255,255,255,.08);
  display:flex; align-items:center; justify-content:center;
  font-size: 26rpx; font-weight: 700;
}
.joined text { font-size: 40rpx; font-weight: 900; color:#ffd75a; margin: 0 6rpx; }
.table-stage { height: 860rpx; display:flex; align-items:center; justify-content:center; }
.round-table {
  position: relative;
  width: 620rpx; height: 620rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #d78a46, #8d5326);
  box-shadow: 0 28rpx 48rpx rgba(0,0,0,.28), inset 0 0 0 14rpx rgba(255,190,105,.35);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
}
.table-inner {
  position:absolute; inset: 22rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,210,145,.28);
}
.start-game {
  position: relative; z-index: 2;
  width: 310rpx; height: 106rpx; border-radius: 54rpx;
  background: linear-gradient(180deg, #ffd458, #ffb225);
  color:#612a0a; font-size: 42rpx; font-weight: 900;
  box-shadow: inset 0 6rpx 0 rgba(255,255,255,.35), 0 10rpx 0 #d07a18;
}
.table-desc { position: relative; z-index:2; color:#fff1dd; font-size:24rpx; margin-top: 22rpx; }
.seat { position: absolute; width: 156rpx; display:flex; flex-direction:column; align-items:center; z-index: 3; }
.seat-0 { top: -60rpx; left: 232rpx; }
.seat-1 { top: 90rpx; right: -44rpx; }
.seat-2 { top: 310rpx; right: -70rpx; }
.seat-3 { bottom: 20rpx; right: 88rpx; }
.seat-4 { bottom: 20rpx; left: 88rpx; }
.seat-5 { top: 310rpx; left: -70rpx; }
.seat-6 { top: 90rpx; left: -44rpx; }
.seat-7 { top: -30rpx; right: 106rpx; }
.avatar-wrap {
  width: 94rpx; height: 94rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #ffffff, #ffe8bf);
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,.22);
  border: 6rpx solid #fff;
  display:flex; align-items:center; justify-content:center;
}
.avatar-wrap.active {
  border-color: #ffd33f;
  box-shadow: 0 0 0 8rpx rgba(255,211,63,.28), 0 10rpx 20rpx rgba(0,0,0,.22);
}
.avatar-face { font-size: 42rpx; }
.seat-name {
  margin-top: 8rpx; max-width: 154rpx;
  padding: 8rpx 12rpx; border-radius: 20rpx;
  background: rgba(86,49,22,.88); color:#fff6e8;
  font-size: 22rpx; font-weight: 800; text-align:center;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.me-tag {
  position:absolute; right: 14rpx; top: -10rpx; z-index: 4;
  min-width: 48rpx; padding: 4rpx 12rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffe887, #ffd047);
  color:#6d3a12; font-weight: 900; text-align:center;
}
.invite-btn {
  width: 270rpx; height: 88rpx; margin: -38rpx auto 0;
  border-radius: 44rpx; color:#fff6e8; font-size: 30rpx; font-weight: 800;
  display:flex; align-items:center; justify-content:center;
  position: relative; z-index: 3;
}
