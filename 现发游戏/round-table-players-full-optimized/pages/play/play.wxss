
.play-room{padding:20rpx 24rpx;margin-bottom:24rpx;display:flex;align-items:center;justify-content:space-between;color:#fff}.room-title{font-size:34rpx;font-weight:900;color:#fff7dc}.round-line{font-size:25rpx;color:#ffe0ad;margin-top:6rpx}.joined{background:rgba(255,255,255,.15);padding:12rpx 20rpx;border-radius:28rpx;font-weight:900}
.play-card{padding:28rpx}.label{display:inline-flex;background:#a06b3d;color:#fff4df;border-radius:22rpx;padding:10rpx 22rpx;font-size:26rpx;font-weight:900}.scenario-big{margin:18rpx 0;background:#fffaf1;border-radius:28rpx;padding:38rpx 26rpx;text-align:center;font-size:36rpx;line-height:1.45;color:#4c2c15;font-weight:900;box-shadow:inset 0 0 0 2rpx #efd7b5}.center{text-align:center}
.recommend-title{font-size:28rpx;font-weight:900;color:#6a3b1b;margin:28rpx 0 16rpx}.songs{display:flex;gap:14rpx}.song-chip{flex:1;background:linear-gradient(180deg,#fff5df,#ffe1b3);border-radius:26rpx;padding:18rpx 8rpx;text-align:center;border:2rpx solid #efd0a5}.song-name{display:block;font-size:30rpx;font-weight:900;color:#653817}.singer{display:block;margin-top:6rpx;font-size:22rpx;color:#a27a58}
.assist-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:24rpx 0}.assist-grid button{background:#845d43;color:#fff5df;border-radius:20rpx;padding:16rpx 6rpx;font-size:22rpx;font-weight:800}
.lyric-box{background:#fff9ef;border-radius:26rpx;padding:22rpx;text-align:center;border:2rpx solid #efd5b2}.lyric-title{font-size:26rpx;font-weight:900;color:#6a3b1b;margin-bottom:14rpx}.lyric-text{font-size:30rpx;font-weight:900;color:#4d2c15}.lyric-note{font-size:22rpx;color:#a17f63;margin-top:14rpx}
.player-progress{display:flex;justify-content:space-around;padding:16rpx;margin:24rpx 0;color:#fff}.progress-item{display:flex;flex-direction:column;align-items:center;font-size:20rpx}.avatar-dot{width:56rpx;height:56rpx;border-radius:50%;background:#fff4df;border:3rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:28rpx}.progress-item.active .avatar-dot{border-color:#ffd43b;box-shadow:0 0 0 6rpx rgba(255,212,59,.25)}.progress-item.active text{color:#ffd43b;font-weight:900}
.button-row{display:flex;gap:18rpx}.button-row .secondary-btn{width:230rpx}.button-row .flex{flex:1}
