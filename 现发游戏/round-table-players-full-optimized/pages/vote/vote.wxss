
.vote-panel{padding:28rpx}.vote-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.big{font-size:36rpx;font-weight:900;color:#553116}.timer{width:128rpx;height:84rpx;border-radius:42rpx;background:linear-gradient(180deg,#795033,#4d2d1b);color:#fff;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:900}.timer text{font-size:48rpx;margin-right:2rpx}
.vote-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx}.vote-item{position:relative;text-align:center;background:#fff9ec;border-radius:26rpx;padding:18rpx 8rpx;font-weight:800;border:3rpx solid transparent;min-height:190rpx}.vote-item.selected{border-color:#ffbd2f;box-shadow:0 0 22rpx rgba(255,189,47,.45)}.avatar-dot{margin:0 auto 10rpx;width:72rpx;height:72rpx;border-radius:50%;background:#fff;border:4rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;box-shadow:0 6rpx 12rpx rgba(0,0,0,.16)}
.player-name{font-size:22rpx;color:#4b2b14;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.vote-count{display:inline-block;background:#8a6247;color:#fff;border-radius:18rpx;padding:6rpx 18rpx;margin-top:8rpx;font-size:22rpx}.status{position:absolute;left:50%;bottom:8rpx;transform:translateX(-50%);background:#f05b55;color:#fff;border-radius:18rpx;padding:4rpx 12rpx;font-size:20rpx}.out{position:absolute;left:50%;bottom:8rpx;transform:translateX(-50%);background:#aaa;color:#fff;border-radius:18rpx;padding:4rpx 12rpx;font-size:20rpx}
.button-row{display:flex;gap:16rpx;margin-top:28rpx;align-items:center}.button-row .secondary-btn{width:150rpx}.button-row .flex{flex:1}.record-btn{width:120rpx;height:92rpx;border-radius:46rpx;background:#b5855d;color:#fff4df;font-size:24rpx;font-weight:800}
