
.role-page{overflow:hidden}.turn-bar{padding:20rpx;color:#fff;margin-bottom:34rpx}.turn-title{text-align:center;font-size:28rpx;font-weight:800}.turn-title text{color:#ffd55b}
.avatar-row{display:flex;justify-content:space-between;margin-top:18rpx}.mini-player{display:flex;flex-direction:column;align-items:center;color:#fff;font-size:20rpx}.avatar-dot{width:58rpx;height:58rpx;border-radius:50%;background:#fff4df;display:flex;align-items:center;justify-content:center;border:3rpx solid #fff;font-size:28rpx}.mini-player.current .avatar-dot{border-color:#ffd43b;box-shadow:0 0 0 6rpx rgba(255,212,59,.25)}.mini-player.current text{background:#ffd43b;color:#5e2b0e;border-radius:16rpx;padding:0 10rpx;margin-top:4rpx;font-weight:900}
.secret-card{position:relative;margin:20rpx 0 30rpx;background:linear-gradient(180deg,#fff5e4,#ffe6bf);border-radius:38rpx;padding:42rpx 32rpx 56rpx;text-align:center;box-shadow:0 20rpx 34rpx rgba(0,0,0,.28),inset 0 0 0 8rpx rgba(143,104,216,.18)}
.ribbon{position:absolute;top:-30rpx;left:130rpx;right:130rpx;height:62rpx;border-radius:30rpx;background:linear-gradient(180deg,#a17cf0,#7b56cf);color:#fff;font-size:28rpx;font-weight:900;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 16rpx rgba(0,0,0,.18)}
.privacy-tag{position:absolute;right:22rpx;top:48rpx;background:#a66f42;color:#fff4df;border-radius:18rpx;padding:10rpx 16rpx;font-size:22rpx;font-weight:800}
.role-line{font-size:38rpx;font-weight:900;margin:34rpx 0 22rpx;color:#4e2d17}.role-line text{font-size:44rpx}.good{color:#3a9a42}.undercover,.wolf,.killer{color:#d63b2d}.sheep{color:#4186d7}
.prompt-card{min-height:300rpx;border-radius:28rpx;background:#fffaf1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28rpx;box-shadow:inset 0 0 0 2rpx #efd7b5}.prompt-card.hidden{background:linear-gradient(180deg,#fff7e7,#f6dfbe)}
.prompt-text{font-size:40rpx;line-height:1.45;font-weight:900;color:#4c2c15}.prompt-note{margin-top:22rpx;color:#a58264;font-size:25rpx}.eye{font-size:70rpx;margin-bottom:16rpx}
.seal{position:absolute;bottom:-32rpx;left:50%;transform:translateX(-50%);width:80rpx;height:80rpx;border-radius:50%;background:linear-gradient(180deg,#8a5cd8,#5c3a9d);border:6rpx solid #eac06a;color:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;box-shadow:0 10rpx 18rpx rgba(0,0,0,.25)}
.privacy-note{margin:50rpx 20rpx 28rpx;text-align:center;color:#ffeed6;font-size:27rpx;font-weight:800}.button-row{display:flex;gap:20rpx}.button-row .secondary-btn{width:250rpx}.button-row .flex{flex:1}
