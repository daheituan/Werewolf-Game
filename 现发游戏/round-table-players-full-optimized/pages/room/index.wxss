.room-main { padding: 28rpx; color:#fff6e6; }
.room-top { display:flex; justify-content:space-between; align-items:center; }
.big-title { font-size: 36rpx; font-weight: 900; color:#fff6e0; }
.copy-btn { width: 180rpx; height: 72rpx; border-radius: 36rpx; background: rgba(255,255,255,.16); color:#fff6e8; font-size: 26rpx; }
.count-line { margin: 24rpx 0 20rpx; color:#ffd873; font-size: 28rpx; font-weight: 800; }
.player-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx; }
.player-item { background: rgba(255,255,255,.08); border-radius: 24rpx; padding: 18rpx 10rpx; text-align:center; }
.player-item .avatar { margin:0 auto 10rpx; width: 88rpx; height: 88rpx; border-radius: 50%; background:#fff6e8; display:flex; align-items:center; justify-content:center; font-size: 40rpx; }
.player-name { color:#fff8ee; font-size: 22rpx; font-weight: 700; }
.start-mini { margin-top: 28rpx; }
