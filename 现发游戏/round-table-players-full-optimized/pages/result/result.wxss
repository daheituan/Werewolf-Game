
.result-card{text-align:center;padding:28rpx}.banner{display:inline-block;background:linear-gradient(180deg,#ffb04a,#f08326);color:#fff;border-radius:22rpx;padding:14rpx 36rpx;font-size:32rpx;font-weight:900;box-shadow:0 8rpx 0 #c96b1c}.winner{font-size:56rpx;font-weight:900;color:#e07316;margin:34rpx 0 10rpx;text-shadow:0 5rpx 0 #fff}.sub{color:#9a795d;font-size:25rpx}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:4rpx;background:#fff7eb;border-radius:24rpx;margin:28rpx 0;padding:18rpx 8rpx}.stats view{border-right:1rpx solid #e7c8a3}.stats view:last-child{border-right:0}.stats text{display:block;font-size:32rpx;font-weight:900;color:#75421d}.stats label{font-size:19rpx;color:#9b7c62}
.identity-title{font-size:32rpx;font-weight:900;margin:26rpx 0 14rpx;color:#5b3519}.identity-list{background:#fff9ec;border-radius:24rpx;padding:10rpx;border:2rpx solid #efd3ad}.identity-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx;border-bottom:1rpx dashed #e5c7a4}.identity-row:last-child{border-bottom:0}.person{display:flex;align-items:center;gap:14rpx;font-weight:900;color:#4b2b14}.avatar-dot{width:58rpx;height:58rpx;border-radius:50%;background:#fff;border:3rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:28rpx}
.role{padding:8rpx 18rpx;border-radius:20rpx;color:#fff;font-weight:900;font-size:24rpx}.role.good{background:#53af58}.role.undercover,.role.wolf,.role.killer{background:#db473c}.role.sheep{background:#4087d7}.role.team{background:#8b65d8}
.result-buttons{display:flex;gap:14rpx;margin-top:26rpx}.result-buttons button{flex:1;height:88rpx;border-radius:44rpx;color:#fff;font-size:28rpx;font-weight:900;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 0 rgba(0,0,0,.18)}.primary-btn.small{font-size:28rpx}.purple-btn{background:linear-gradient(180deg,#a575ff,#7a4fe2)}.green-btn{background:linear-gradient(180deg,#65d66a,#37a844)}
.home-btn{width:260rpx;height:72rpx;border-radius:36rpx;margin:22rpx auto 0;background:rgba(255,255,255,.18);color:#fff;font-weight:800}
