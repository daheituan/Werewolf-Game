.seg{height:80rpx;border-radius:42rpx;background:rgba(255,255,255,.13);display:flex;align-items:center;justify-content:space-around;color:#fff;margin-bottom:24rpx}.seg text{padding:18rpx 34rpx;border-radius:38rpx;font-weight:800}.seg .on{background:#ffc33f;color:#6b310f}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-bottom:30rpx}.game-card{position:relative;min-height:250rpx;border-radius:28rpx;padding:24rpx;background:rgba(255,244,224,.92);box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}.game-card.selected{outline:6rpx solid #ffc442;box-shadow:0 0 28rpx rgba(255,196,66,.5)}.game-card.disabled{opacity:.55}.game-ico{width:92rpx;height:92rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:52rpx;margin-bottom:14rpx}.game-name{font-size:30rpx;font-weight:900}.game-desc{font-size:24rpx;color:#76543c;margin:8rpx 0 14rpx}.meta{font-size:20rpx;color:#8a705b;display:flex;flex-direction:column;gap:4rpx}.coming{position:absolute;right:18rpx;top:18rpx;background:#756f70;color:#fff;border-radius:18rpx;padding:6rpx 14rpx;font-size:20rpx}
