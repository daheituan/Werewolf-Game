.bottom-nav {
  position: fixed;
  left: 24rpx; right: 24rpx; bottom: 24rpx;
  height: 118rpx;
  border-radius: 40rpx;
  background: rgba(255,248,240,.96);
  box-shadow: 0 16rpx 32rpx rgba(0,0,0,.25), inset 0 1rpx 0 rgba(255,255,255,.8);
  display:flex; align-items:center; justify-content:space-around;
  z-index: 99;
}
.nav-item {
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
  color:#97908a; font-weight:800;
}
.nav-item .icon {
  width: 54rpx; height: 54rpx; border-radius: 18rpx;
  display:flex; align-items:center; justify-content:center;
  font-size: 34rpx;
}
.nav-item text { margin-top: 2rpx; font-size: 22rpx; }
.nav-item.active { color:#f29c1f; }
.nav-item.active .icon { background:#fcead0; }
.nav-item.room.active { color:#8f76ff; }
.nav-item.room.active .icon { background:#ede7ff; }
